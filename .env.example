# Copy this file to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production-only HTTPS controls (enable after HTTPS/proxy is verified).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DB_CONN_MAX_AGE=60

# Configure these when using real email and live Google Maps places.
GOOGLE_MAPS_PLACES_API_KEY=
# Optional: live no-key fallback endpoint (default is Overpass public API).
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
CORS_ALLOWED_ORIGINS=
PASSWORD_RESET_FRONTEND_URL=sportmate://reset-password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Court-backed game lifecycle policy
GAME_ALMOST_FULL_SLOTS_THRESHOLD=1
GAME_MAX_SKILL_LEVEL_DIFFERENCE=1

# Plain-text chat message limit
CHAT_MESSAGE_MAX_LENGTH=2000
